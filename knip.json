{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": [
        "*.js"
      ]
    },
    "packages/build": {
      "project": [
        "src/**/*.ts"
      ],
      "ignoreDependencies": [
        "@lvce-editor/verror",
        "esbuild",
        "playwright"
      ]
    },
    "packages/completion-worker": {
      "entry": [
        "src/completionWorkerMain.ts",
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "packages/e2e": {
      "entry": [
        "src/**/*.ts",
        "fixtures/**/main.ts"
      ],
      "project": [
        "src/**/*.ts",
        "fixtures/**/*.ts"
      ]
    },
    "packages/server": {
      "project": [
        "src/**/*.js"
      ]
    }
  }
}
