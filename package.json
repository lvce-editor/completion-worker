{
  "name": "@lvce-editor/completion-worker-monorepo",
  "version": "0.0.0-dev",
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/build/src/build.ts",
    "build:static": "node packages/build/src/build-static.ts",
    "build:watch": "./node_modules/.bin/esbuild --format=esm --bundle --external:node:buffer --external:electron --external:ws --external:node:worker_threads --watch packages/completion-worker/src/completionWorkerMain.ts --outfile=.tmp/dist/dist/completionWorkerMain.js",
    "dev": "node packages/build/src/dev.ts",
    "e2e": "cd packages/e2e && npm run e2e:headless",
    "format": "prettier --write .",
    "lint": "eslint . && knip --no-config-hints",
    "measure": "cd packages/memory && npm run measure",
    "test": "npm test --workspaces --if-present",
    "type-check": "tsc -b"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 150
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^18.14.2",
    "@lvce-editor/eslint-plugin-tsconfig": "^18.14.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "knip": "^6.38.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  }
}
